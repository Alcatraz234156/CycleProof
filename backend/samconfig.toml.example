version = 0.1

[default.deploy.parameters]
stack_name = "cycleproof-dev"
resolve_s3 = true
s3_prefix = "cycleproof-dev"
region = "ap-south-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
parameter_overrides = "AppEnvironment=dev AllowedOrigin=http://localhost:5173"
image_repositories = []
